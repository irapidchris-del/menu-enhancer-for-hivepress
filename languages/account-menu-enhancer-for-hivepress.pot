#: includes/configs/settings.php:256
msgid "WooCommerce Integration"
msgstr ""

#: includes/configs/settings.php:257
msgid "Show WooCommerce account pages inside the HivePress account layout"
msgstr ""

#: includes/configs/settings.php:258
msgid "Renders the WooCommerce account pages (Dashboard, Addresses, Payment methods, Account details and Downloads) inside the HivePress account template, the same way HivePress already displays the Orders page, so every account page shares one sidebar menu."
msgstr ""

#: includes/configs/settings.php:265
msgid "Menu Merging"
msgstr ""

#: includes/configs/settings.php:266
msgid "Merge the HivePress and WooCommerce account menus"
msgstr ""

#: includes/configs/settings.php:267
msgid "Adds the WooCommerce account links to the HivePress menu, and the HivePress account links to the WooCommerce menu, so both menus list the same items."
msgstr ""

