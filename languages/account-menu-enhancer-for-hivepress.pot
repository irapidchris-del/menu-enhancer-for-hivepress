#: includes/configs/settings.php:600
msgid "Show the HivePress counters in the WooCommerce menu"
msgstr ""

#: includes/configs/settings.php:601
msgid "Mirrors the HivePress menu counters (for example unread messages) into the WooCommerce account menu."
msgstr ""

#: includes/configs/settings.php:609
msgid "WooCommerce Page Header"
msgstr ""

#: includes/configs/settings.php:610
msgid "Hide the page header on WooCommerce account pages"
msgstr ""

#: includes/configs/settings.php:611
msgid "Hides the large page title header on the WooCommerce account pages so they match the HivePress account pages."
msgstr ""

#: includes/configs/settings.php:636
msgid "Also Hidden from the WooCommerce Menu"
msgstr ""

#: includes/configs/settings.php:637
msgid "The menu items hidden from the WooCommerce account menu only. They stay in the HivePress account dropdown and sidebar, so your members can still reach them there. Anything chosen in Hidden Items above is already hidden from every menu."
msgstr ""
